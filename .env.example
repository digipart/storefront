# Copy to .env and fill in. NEVER commit .env, never paste its values anywhere.
DIGIPART_URL=https://app.example.com
ID_MARKET_PLACE=
CLIENT_ID=
CLIENT_SECRET=
CACHE_SECONDS=300

# Optional: address suggestions on the order page (Google Places API "New": Autocomplete + Place Details). Used from the server only.
GOOGLE_PLACES_KEY=

# Optional: the return portal of the shop, e.g. https://return.digipart.fr/<brand>. An order Digipart says can be returned gets a link to it in the customer account.
RETURN_PORTAL_URL=
