{
  "name": "digipart-storefront",
  "private": true,
  "type": "module",
  "description": "The site engine of Digipart Commerce: draws the online shops built in Digipart (site builder, themes) from api/storefront.",
  "scripts": {
    "dev": "nuxt dev --port 3100",
    "build": "nuxt build",
    "start": "PORT=3100 HOST=127.0.0.1 node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "local": "nuxt build && sh dev/start-local.sh",
    "local:start": "sh dev/start-local.sh",
    "local:dev": "sh dev/dev-local.sh",
    "local:stop": "kill $(lsof -tiTCP:3100 -sTCP:LISTEN) 2>/dev/null || true"
  },
  "dependencies": {
    "liquidjs": "10.30.1",
    "nuxt": "4.2.1",
    "sanitize-html": "2.18.1",
    "vue": "3.5.25"
  }
}
